# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AskICT data
# committed: data/raw (dataset) and data/index (vector database)
# local only: user accounts + saved chats, the downloaded embedding model, the cloned ictukb repo
/data/app.db*
/data/models/
/data/external/
# the official fee PDF contains bank account numbers; we commit its transcription (data/raw/notes) instead
/data/raw/pdf/
!.env.example
