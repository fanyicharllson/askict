# AskICT runs fully locally by default: no API key needed.
# The local model is served by `npm run llm` (llama.cpp + LFM3-1.7B) at this address:
LOCAL_LLM_URL=http://127.0.0.1:8080/v1
# Passages sent to the local model (fewer = faster on a small CPU)
LOCAL_TOP_K=4

# Optional cloud mode for a fast demo (needs a key from https://console.groq.com/keys):
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# CHAT_MODEL=openai/gpt-oss-120b

# WhatsApp number for "Report an issue", international format without + (e.g. 2376XXXXXXXX)
NEXT_PUBLIC_SUPPORT_WHATSAPP=
